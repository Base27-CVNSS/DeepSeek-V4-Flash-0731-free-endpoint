# Copy this file to .dev.vars for local development. Never commit .dev.vars.
# Add at least one provider key. Keys belong to your own provider accounts.

OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
HF_TOKEN=

# Hugging Face has no safe universal chat-model default; choose one explicitly.
HF_MODEL=

# Optional protection for Chat Completions. Status/model metadata stays public
# so the bundled UI can display readiness without exposing provider secrets.
GATEWAY_TOKEN=

# Optional app settings.
APP_NAME=Base27 Free LLM Router
APP_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8787
PUBLIC_RPM=30
PUBLIC_BURST=20
MAX_PROVIDER_ATTEMPTS=5
UPSTREAM_TIMEOUT_MS=60000
